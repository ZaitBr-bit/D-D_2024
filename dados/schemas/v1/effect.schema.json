{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/effect.schema.json",
  "title": "Effect (v1)",
  "description": "Vocabulário fechado de efeitos de regra. `type` é um enum fechado; cada tipo tem um formato próprio e fechado (additionalProperties:false). `when` é a expressão de condição opcional que controla se o efeito está ativo, com vocabulário de condição também fechado (sem path de propriedade livre). A Task 15 acrescentou `priority` (a todos os tipos; ausência equivale a 0) e `stackKey`/`stackable` (aos tipos de conjunto/concessão e também a `modifier`, para que a resolução numérica possa marcar ladders de nível como não acumuláveis). O motor determinístico que consome esses campos é site/js/domain/effects/**; a ausência de `stackKey` significa que o efeito sempre acumula.",
  "$ref": "#/$defs/effect",
  "$defs": {
    "effectType": {
      "enum": [
        "modifier",
        "proficiency",
        "language",
        "defense",
        "grant-spell",
        "grant-item",
        "resource",
        "choice",
        "condition",
        "official-handler",
        "manual"
      ]
    },
    "conditionExpr": {
      "description": "Expressão de gating fechada: apenas level, choice, equipped, state-flag, all, any e not. Nunca um path de propriedade livre.",
      "oneOf": [
        {
          "$ref": "#/$defs/conditionLevel"
        },
        {
          "$ref": "#/$defs/conditionChoice"
        },
        {
          "$ref": "#/$defs/conditionEquipped"
        },
        {
          "$ref": "#/$defs/conditionStateFlag"
        },
        {
          "$ref": "#/$defs/conditionAll"
        },
        {
          "$ref": "#/$defs/conditionAny"
        },
        {
          "$ref": "#/$defs/conditionNot"
        }
      ]
    },
    "conditionLevel": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "level"
        },
        "class": {
          "$ref": "common.schema.json#/$defs/classRef"
        },
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "kind",
        "min"
      ],
      "additionalProperties": false
    },
    "conditionChoice": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "choice"
        },
        "choiceId": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "equals": {
          "$ref": "common.schema.json#/$defs/localSlug"
        }
      },
      "required": [
        "kind",
        "choiceId",
        "equals"
      ],
      "additionalProperties": false
    },
    "conditionEquipped": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "equipped"
        },
        "item": {
          "$ref": "common.schema.json#/$defs/itemRef"
        }
      },
      "required": [
        "kind",
        "item"
      ],
      "additionalProperties": false
    },
    "conditionStateFlag": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "state-flag"
        },
        "flag": {
          "description": "Enum fechado de flags de estado reconhecidas. Sem path de propriedade livre.",
          "enum": [
            "raging",
            "concentrating",
            "surprised",
            "hidden",
            "prone",
            "unconscious",
            "dead",
            "inspired",
            "bloodied"
          ]
        },
        "equals": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "kind",
        "flag"
      ],
      "additionalProperties": false
    },
    "conditionAll": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "all"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditionExpr"
          }
        }
      },
      "required": [
        "kind",
        "conditions"
      ],
      "additionalProperties": false
    },
    "conditionAny": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "any"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditionExpr"
          }
        }
      },
      "required": [
        "kind",
        "conditions"
      ],
      "additionalProperties": false
    },
    "conditionNot": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "not"
        },
        "condition": {
          "$ref": "#/$defs/conditionExpr"
        }
      },
      "required": [
        "kind",
        "condition"
      ],
      "additionalProperties": false
    },
    "effect": {
      "description": "Um efeito é um dos 11 tipos fechados abaixo, discriminado por `type`.",
      "oneOf": [
        {
          "$ref": "#/$defs/modifierEffect"
        },
        {
          "$ref": "#/$defs/proficiencyEffect"
        },
        {
          "$ref": "#/$defs/languageEffect"
        },
        {
          "$ref": "#/$defs/defenseEffect"
        },
        {
          "$ref": "#/$defs/grantSpellEffect"
        },
        {
          "$ref": "#/$defs/grantItemEffect"
        },
        {
          "$ref": "#/$defs/resourceEffect"
        },
        {
          "$ref": "#/$defs/choiceEffect"
        },
        {
          "$ref": "#/$defs/conditionEffect"
        },
        {
          "$ref": "#/$defs/officialHandlerEffect"
        },
        {
          "$ref": "#/$defs/manualEffect"
        }
      ]
    },
    "modifierEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "modifier"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "target": {
          "type": "string",
          "description": "Caminho pontilhado do atributo alvo (ex.: \"ability.strength.score\"). O primeiro segmento é restrito a um vocabulário fechado de namespaces conhecidos do modelo de personagem (não um path arbitrário) — isso é, de propósito, o único write-path livre do vocabulário de efeitos, então é fechado por whitelist em vez de blacklist. A negative lookahead adicional bloqueia segmentos reservados de prototype-pollution (constructor/prototype/__proto__/...) em qualquer posição do caminho, como defesa em profundidade caso o vocabulário de namespaces seja ampliado no futuro.",
          "pattern": "^(?!.*\\b(?:constructor|prototype|__proto__|toString|valueOf|hasOwnProperty|__defineGetter__|__defineSetter__)\\b)(?:ability|skill|save|ac|speed|hp|initiative|attack|damage|proficiency-bonus|resource|spell-slot|senses|size|passive-perception|carrying-capacity)(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "operation": {
          "enum": [
            "set",
            "add",
            "multiply",
            "min",
            "max"
          ]
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        },
        "stackKey": {
          "$ref": "#/$defs/effectStackKey"
        },
        "stackable": {
          "$ref": "#/$defs/effectStackable"
        }
      },
      "required": [
        "type",
        "target",
        "operation",
        "value"
      ],
      "additionalProperties": false
    },
    "proficiencyEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "proficiency"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/proficiencyTargetRef"
        },
        "level": {
          "enum": [
            "proficient",
            "expertise"
          ]
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        },
        "stackKey": {
          "$ref": "#/$defs/effectStackKey"
        },
        "stackable": {
          "$ref": "#/$defs/effectStackable"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "additionalProperties": false
    },
    "languageEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "language"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "language": {
          "$ref": "common.schema.json#/$defs/languageRef"
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        },
        "stackKey": {
          "$ref": "#/$defs/effectStackKey"
        },
        "stackable": {
          "$ref": "#/$defs/effectStackable"
        }
      },
      "required": [
        "type",
        "language"
      ],
      "additionalProperties": false
    },
    "defenseEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "defense"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "damageType": {
          "$ref": "common.schema.json#/$defs/damageTypeRef"
        },
        "mode": {
          "enum": [
            "resistance",
            "immunity",
            "vulnerability"
          ]
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        },
        "stackKey": {
          "$ref": "#/$defs/effectStackKey"
        },
        "stackable": {
          "$ref": "#/$defs/effectStackable"
        }
      },
      "required": [
        "type",
        "damageType",
        "mode"
      ],
      "additionalProperties": false
    },
    "grantSpellEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "grant-spell"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "spell": {
          "$ref": "common.schema.json#/$defs/spellRef"
        },
        "alwaysPrepared": {
          "type": "boolean"
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        },
        "stackKey": {
          "$ref": "#/$defs/effectStackKey"
        },
        "stackable": {
          "$ref": "#/$defs/effectStackable"
        }
      },
      "required": [
        "type",
        "spell"
      ],
      "additionalProperties": false
    },
    "grantItemEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "grant-item"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "item": {
          "$ref": "common.schema.json#/$defs/itemRef"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        },
        "stackKey": {
          "$ref": "#/$defs/effectStackKey"
        },
        "stackable": {
          "$ref": "#/$defs/effectStackable"
        }
      },
      "required": [
        "type",
        "item"
      ],
      "additionalProperties": false
    },
    "resourceEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "resource"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "resource": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "max": {
          "type": [
            "integer",
            "string"
          ]
        },
        "recovery": {
          "enum": [
            "short-rest",
            "long-rest",
            "dawn",
            "none"
          ]
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        },
        "stackKey": {
          "$ref": "#/$defs/effectStackKey"
        },
        "stackable": {
          "$ref": "#/$defs/effectStackable"
        }
      },
      "required": [
        "type",
        "resource",
        "max"
      ],
      "additionalProperties": false
    },
    "choiceEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "choice"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "choice": {
          "$ref": "choice.schema.json#"
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        }
      },
      "required": [
        "type",
        "choice"
      ],
      "additionalProperties": false
    },
    "conditionEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "condition"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/conditionRef"
        },
        "duration": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        },
        "stackKey": {
          "$ref": "#/$defs/effectStackKey"
        },
        "stackable": {
          "$ref": "#/$defs/effectStackable"
        }
      },
      "required": [
        "type",
        "condition"
      ],
      "additionalProperties": false
    },
    "officialHandlerEffect": {
      "type": "object",
      "description": "Escape hatch fechado para regras complexas demais para modelagem declarativa. `handlerId` identifica um handler de código conhecido; `params` é a configuração opaca desse handler específico (conteúdo intencionalmente livre porque é interno a um handler já revisado no código, não dado arbitrário de terceiros).",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "official-handler"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "handlerId": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "params": {
          "type": "object"
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        }
      },
      "required": [
        "type",
        "handlerId"
      ],
      "additionalProperties": false
    },
    "manualEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/localSlug"
        },
        "type": {
          "const": "manual"
        },
        "when": {
          "$ref": "#/$defs/conditionExpr"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "priority": {
          "$ref": "#/$defs/effectPriority"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "effectPriority": {
      "type": "integer",
      "description": "Ordem de aplicação DENTRO do grupo de precedência (base; classe/espécie/antecedente/talento; equipamento/temporário; override manual). Prioridades maiores são aplicadas por último. A AUSÊNCIA deste campo equivale a 0 — não é um valor inventado pelo motor, é o contrato do vocabulário (ver site/js/domain/effects/effect-predicates.js: effectPriority)."
    },
    "effectStackKey": {
      "$ref": "common.schema.json#/$defs/localSlug",
      "description": "Chave de empilhamento. Duas contribuições com a MESMA stackKey e stackable:false não acumulam: só sobrevive a de maior precedência. A AUSÊNCIA de stackKey significa que o efeito SEMPRE acumula e nunca é filtrado por deduplicação."
    },
    "effectStackable": {
      "type": "boolean",
      "default": true,
      "description": "Se o efeito acumula com outros da mesma stackKey. Ausência equivale a true. Declarar false SEM stackKey é inválido semanticamente (não haveria por onde deduplicar) e é recusado por validateEffectSemantics."
    }
  }
}
