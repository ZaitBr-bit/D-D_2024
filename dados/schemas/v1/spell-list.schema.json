{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/spell-list.schema.json",
  "title": "Spell list entity (v1)",
  "description": "Lista nomeada de magias (ex.: lista de magias de Mago).",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "spell-list" },
        "spells": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/spellRef" }
        }
      },
      "required": ["type", "spells"]
    }
  ],
  "unevaluatedProperties": false
}
