{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/glossary-entry.schema.json",
  "title": "Glossary entry entity (v1)",
  "description": "Entrada de glossário de regras (termo + definição), sem impacto mecânico direto.",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "glossary-entry" },
        "term": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "definition": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "required": ["type", "term", "definition"]
    }
  ],
  "unevaluatedProperties": false
}
