{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/damage-type.schema.json",
  "title": "Damage type entity (v1)",
  "description": "Tipo de dano (ex.: Cortante, Fogo), referenciado por effect.schema.json (tipo 'defense') e por weapon.schema.json.",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "damage-type" }
      },
      "required": ["type"]
    }
  ],
  "unevaluatedProperties": false
}
