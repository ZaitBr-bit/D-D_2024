{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/ability.schema.json",
  "title": "Ability entity (v1)",
  "description": "Habilidade (atributo) base, ex.: Força, Destreza.",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "ability" },
        "abbreviation": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": ["type", "abbreviation"]
    }
  ],
  "unevaluatedProperties": false
}
