{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/language.schema.json",
  "title": "Language entity (v1)",
  "description": "Idioma jogável (ex.: Comum, Élfico).",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "language" },
        "script": { "type": "string" }
      },
      "required": ["type"]
    }
  ],
  "unevaluatedProperties": false
}
