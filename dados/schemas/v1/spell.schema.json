{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/spell.schema.json",
  "title": "Spell entity (v1)",
  "description": "Magia (ex.: Bola de Fogo).",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "spell" },
        "level": { "type": "integer", "minimum": 0, "maximum": 9 },
        "school": {
          "enum": [
            "abjuration",
            "conjuration",
            "divination",
            "enchantment",
            "evocation",
            "illusion",
            "necromancy",
            "transmutation"
          ]
        },
        "castingTime": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "range": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "components": {
          "type": "object",
          "properties": {
            "verbal": { "type": "boolean" },
            "somatic": { "type": "boolean" },
            "material": { "type": "boolean" },
            "materialDescription": { "type": "string" },
            "materialCostOrConsumed": {
              "type": "boolean",
              "description": "Verdadeiro quando o componente material tem custo em moedas ou é consumido pela magia — a distinção que as tabelas de lista de magia por classe do legado marcam com \"M\" na coluna `especial` (magia com material comum NÃO recebe a marca). Acrescentado na Task 23b, com valor vindo dessa mesma coluna (`dados/classes/magias_*.json`), que é a única fonte legada que carrega a informação; nunca inferido por regex sobre `materialDescription`. Ausente (não `false`) para magia sem material e para magia que não aparece em nenhuma lista de classe."
            }
          },
          "required": ["verbal", "somatic", "material"],
          "additionalProperties": false
        },
        "duration": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "concentration": { "type": "boolean" },
        "ritual": { "type": "boolean" },
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/classRef" }
        }
      },
      "required": [
        "type",
        "level",
        "school",
        "castingTime",
        "range",
        "components",
        "duration",
        "concentration",
        "ritual",
        "classes"
      ]
    }
  ],
  "unevaluatedProperties": false
}
