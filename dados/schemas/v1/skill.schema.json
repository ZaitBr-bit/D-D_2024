{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/skill.schema.json",
  "title": "Skill entity (v1)",
  "description": "Perícia, associada a uma habilidade base (ex.: Furtividade -> Destreza).",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "skill" },
        "ability": { "$ref": "common.schema.json#/$defs/abilityRef" }
      },
      "required": ["type", "ability"]
    }
  ],
  "unevaluatedProperties": false
}
