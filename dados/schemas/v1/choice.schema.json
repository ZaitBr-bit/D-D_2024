{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/choice.schema.json",
  "title": "Choice (v1)",
  "description": "Estrutura de escolha reutilizável (ex.: 'escolha 2 perícias entre...'), referenciada por effect.schema.json (tipo 'choice') e por entidades que oferecem opções ao jogador.",
  "$ref": "#/$defs/choice",
  "$defs": {
    "choiceOption": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localSlug" },
        "label": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "grants": {
          "type": "array",
          "items": { "$ref": "effect.schema.json#" }
        }
      },
      "required": ["id", "label"],
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localSlug" },
        "prompt": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/choiceOption" }
        }
      },
      "required": ["id", "prompt", "min", "max", "options"],
      "additionalProperties": false
    }
  }
}
