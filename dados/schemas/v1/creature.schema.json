{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/creature.schema.json",
  "title": "Creature entity (v1)",
  "description": "Criatura/monstro (bloco de estatísticas).",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "creature" },
        "size": { "enum": ["tiny", "small", "medium", "large", "huge", "gargantuan"] },
        "creatureType": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "challengeRating": { "type": "number", "minimum": 0 },
        "armorClass": { "type": "integer", "minimum": 0 },
        "hitPoints": { "type": "integer", "minimum": 1 }
      },
      "required": ["type", "size", "creatureType", "challengeRating", "armorClass", "hitPoints"]
    }
  ],
  "unevaluatedProperties": false
}
