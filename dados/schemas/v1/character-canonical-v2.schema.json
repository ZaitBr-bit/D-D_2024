{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/character-canonical-v2.schema.json",
  "title": "Character canonical model (v2)",
  "description": "Modelo interno canônico de um personagem: representação aninhada, expandida em memória a partir do registro persistido (character-record-v2). Não é o formato persistido — ver character-record-v2.schema.json para o registro plano gravado em disco/Firestore. Estendido pela Task 12 (site/js/domain/character/model.js) a partir do esqueleto mínimo da Task 5: identity (dados pessoais/flavor), build (escolhas de construção do personagem e referências de conteúdo), state (estado mutável de jogo), overrides (ajustes manuais sobre campos derivados), extensions (dados legados não modelados) e metadata (timestamps/config de criação). Máximos derivados (PV máximo, dados de vida máximos, slots máximos, recursos máximos) não são fonte aqui — são recalculados do ruleset+conteúdo; um ajuste manual vai em overrides.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 2 },
    "identity": { "$ref": "#/$defs/identity" },
    "build": { "$ref": "#/$defs/build" },
    "state": { "$ref": "#/$defs/state" },
    "overrides": { "$ref": "#/$defs/overrides" },
    "extensions": { "$ref": "#/$defs/extensions" },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "required": ["schemaVersion", "identity", "build", "state", "overrides", "extensions", "metadata"],
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "name": { "type": "string" },
        "image": { "type": "string" },
        "alignment": { "type": "string" },
        "size": { "type": "string" },
        "appearance": { "type": "string" },
        "personality": { "type": "string" },
        "ideals": { "type": "string" },
        "bonds": { "type": "string" },
        "flaws": { "type": "string" },
        "backstory": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "name", "image", "alignment", "size", "appearance", "personality", "ideals", "bonds", "flaws", "backstory", "notes"],
      "additionalProperties": false
    },

    "contentRef": {
      "description": "Referência genérica de conteúdo com versão de pacote explícita. Schemas concretos restringem `id` a um dos $defs tipados de common.schema.json (classRef, spellRef, ...).",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/contentId" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "rulesetContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/rulesetRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "classContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/classRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "subclassContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/subclassRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "speciesContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/speciesRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "backgroundContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/backgroundRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "featContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/featRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "spellContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/spellRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "itemContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/itemRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "weaponContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/weaponRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },
    "featureContentRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/featureRef" },
        "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
      },
      "required": ["id", "packageVersion"],
      "additionalProperties": false
    },

    "contentScopes": {
      "description": "Um escopo por namespace de conteúdo ativo na ficha; IDs nus (sem packageVersion explícito) em arrays/chaves/escolhas herdam a versão daqui pelo namespace do próprio ContentId.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "packageVersion": { "$ref": "common.schema.json#/$defs/semVer" }
        },
        "required": ["packageVersion"],
        "additionalProperties": false
      }
    },

    "abilityScoreSet": {
      "type": "object",
      "properties": {
        "forca": { "type": "integer", "minimum": 1, "maximum": 30 },
        "destreza": { "type": "integer", "minimum": 1, "maximum": 30 },
        "constituicao": { "type": "integer", "minimum": 1, "maximum": 30 },
        "inteligencia": { "type": "integer", "minimum": 1, "maximum": 30 },
        "sabedoria": { "type": "integer", "minimum": 1, "maximum": 30 },
        "carisma": { "type": "integer", "minimum": 1, "maximum": 30 }
      },
      "required": ["forca", "destreza", "constituicao", "inteligencia", "sabedoria", "carisma"],
      "additionalProperties": false
    },

    "legacyGrants": {
      "description": "Proficiências/idiomas/defesas legadas sem origem (feature concessora) reconstruível — preservadas como concessões soltas em vez de perdidas ou inventadas.",
      "type": "object",
      "properties": {
        "skillProficiencyIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/skillRef" } },
        "skillExpertiseIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/skillRef" } },
        "savingThrowProficiencyIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/abilityRef" } },
        "languageIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/languageRef" } },
        "toolProficiencyIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } },
        "instrumentProficiencyIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } },
        "otherProficiencies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } },
        "resistanceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/damageTypeRef" } },
        "vulnerabilityIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/damageTypeRef" } },
        "immunityIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "skillProficiencyIds",
        "skillExpertiseIds",
        "savingThrowProficiencyIds",
        "languageIds",
        "toolProficiencyIds",
        "instrumentProficiencyIds",
        "otherProficiencies",
        "resistanceIds",
        "vulnerabilityIds",
        "immunityIds"
      ],
      "additionalProperties": false
    },

    "build": {
      "type": "object",
      "properties": {
        "contentScopes": { "$ref": "#/$defs/contentScopes" },
        "rulesetRef": { "$ref": "#/$defs/rulesetContentRef" },
        "classRef": { "anyOf": [{ "$ref": "#/$defs/classContentRef" }, { "type": "null" }] },
        "subclassRef": { "anyOf": [{ "$ref": "#/$defs/subclassContentRef" }, { "type": "null" }] },
        "speciesRef": { "anyOf": [{ "$ref": "#/$defs/speciesContentRef" }, { "type": "null" }] },
        "backgroundRef": { "anyOf": [{ "$ref": "#/$defs/backgroundContentRef" }, { "type": "null" }] },
        "choices": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "abilityGeneration": {
          "type": "object",
          "properties": {
            "method": { "enum": ["standard", "pointbuy", "rolled", "manual"] },
            "base": { "$ref": "#/$defs/abilityScoreSet" },
            "rolls": { "type": "array", "items": { "type": "number" } }
          },
          "required": ["method", "base", "rolls"],
          "additionalProperties": false
        },
        "featRefs": { "type": "array", "items": { "$ref": "#/$defs/featContentRef" } },
        "weaponMasteryRefs": {
          "description": "Maestrias de arma escolhidas (site/js legado: campo `maestrias_arma`).",
          "type": "array",
          "items": { "$ref": "#/$defs/weaponContentRef" }
        },
        "maneuverRefs": {
          "description": "Manobras de combate conhecidas (site/js legado: campo `manobras_conhecidas`); modeladas como referências a `feature`, o tipo de entidade de conteúdo usado para capacidades concedidas por classe/subclasse.",
          "type": "array",
          "items": { "$ref": "#/$defs/featureContentRef" }
        },
        "legacyGrants": { "$ref": "#/$defs/legacyGrants" },
        "options": {
          "type": "object",
          "properties": {
            "encumbranceAffectsMovement": { "type": "boolean" }
          },
          "required": ["encumbranceAffectsMovement"],
          "additionalProperties": false
        }
      },
      "required": [
        "contentScopes",
        "rulesetRef",
        "classRef",
        "subclassRef",
        "speciesRef",
        "backgroundRef",
        "choices",
        "abilityGeneration",
        "featRefs",
        "weaponMasteryRefs",
        "maneuverRefs",
        "legacyGrants",
        "options"
      ],
      "additionalProperties": false
    },

    "instanceId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },

    "spellEntry": {
      "type": "object",
      "properties": {
        "instanceId": { "$ref": "#/$defs/instanceId" },
        "spellRef": { "$ref": "#/$defs/spellContentRef" },
        "customDefinition": { "type": ["object", "null"] },
        "sourceInstanceId": { "type": ["string", "null"] }
      },
      "required": ["instanceId", "customDefinition", "sourceInstanceId"],
      "additionalProperties": false
    },

    "inventoryEntry": {
      "type": "object",
      "properties": {
        "instanceId": { "$ref": "#/$defs/instanceId" },
        "itemRef": { "anyOf": [{ "$ref": "#/$defs/itemContentRef" }, { "type": "null" }] },
        "customDefinition": { "type": ["object", "null"] },
        "quantity": { "type": "integer", "minimum": 0 },
        "equipped": { "type": "boolean" },
        "expended": { "type": "integer", "minimum": 0 },
        "sourceInstanceId": { "type": ["string", "null"] }
      },
      "required": ["instanceId", "itemRef", "customDefinition", "quantity", "equipped", "expended", "sourceInstanceId"],
      "additionalProperties": false
    },

    "resourceState": {
      "type": "object",
      "properties": {
        "current": { "type": "integer" },
        "sourceInstanceId": { "type": ["string", "null"] }
      },
      "required": ["current"],
      "additionalProperties": false
    },

    "state": {
      "type": "object",
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 20 },
        "xp": { "type": "integer", "minimum": 0 },
        "abilities": { "$ref": "#/$defs/abilityScoreSet" },
        "hitPoints": {
          "type": "object",
          "properties": {
            "current": { "type": "integer" },
            "temporary": { "type": "integer", "minimum": 0 }
          },
          "required": ["current", "temporary"],
          "additionalProperties": false
        },
        "hitDice": {
          "type": "object",
          "properties": { "used": { "type": "integer", "minimum": 0 } },
          "required": ["used"],
          "additionalProperties": false
        },
        "hitPointRolls": {
          "description": "Histórico de PV ganho por nível (Task 23). É FONTE, não derivado: cada level-up acrescenta uma entrada. O PV máximo é SEMPRE recomputado a partir daqui + modificador de Constituição + bônus de conteúdo, nunca lido de um valor congelado — por isso `state.hitPoints` não guarda `maximum` e `overrides[\"hp.maximum\"]` continua reservado exclusivamente ao ajuste manual explícito do usuário.\n\nCampo OPCIONAL por extensão incremental: um registro migrado de v1 não tem histórico de rolagens (o legado só guardava o `pv_max` final), e inventar entradas plausíveis violaria a proibição de default de migração. Ausência significa \"histórico desconhecido\", não \"zero PV rolado\" — quem consome deve falhar explicitamente ou usar o override manual, nunca assumir a média.\n\n`rolled` é `null` quando o método não determina um valor por si (histórico importado sem o número), e nunca é preenchido com um valor plausível.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": { "type": "integer", "minimum": 1, "maximum": 20 },
              "rolled": { "type": ["integer", "null"], "minimum": 1 },
              "method": { "enum": ["roll", "average", "fixed"] }
            },
            "required": ["level", "rolled", "method"],
            "additionalProperties": false
          }
        },
        "deathSaves": {
          "type": "object",
          "properties": {
            "successes": { "type": "integer", "minimum": 0, "maximum": 3 },
            "failures": { "type": "integer", "minimum": 0, "maximum": 3 }
          },
          "required": ["successes", "failures"],
          "additionalProperties": false
        },
        "exhaustion": { "type": "integer", "minimum": 0, "maximum": 6 },
        "heroicInspiration": { "type": "boolean" },
        "resources": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/contentId" },
          "additionalProperties": { "$ref": "#/$defs/resourceState" }
        },
        "spells": {
          "type": "object",
          "properties": {
            "known": { "type": "array", "items": { "$ref": "#/$defs/spellEntry" } },
            "prepared": { "type": "array", "items": { "$ref": "#/$defs/spellEntry" } },
            "spellbook": { "type": "array", "items": { "$ref": "#/$defs/spellEntry" } },
            "slots": {
              "type": "object",
              "propertyNames": { "pattern": "^[1-9]$" },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "used": { "type": "integer", "minimum": 0 },
                  "extra": {
                    "description": "Espaços extras concedidos por círculo além do total da tabela de classe (ex.: convertidos de Pontos de Feitiçaria via Fonte de Magia; site/js/pages/sheet.js campo legado `espacos_magia_extras`). Não é um máximo derivado do ruleset — é uma concessão registrada, por isso é fonte no canônico.",
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": ["used", "extra"],
                "additionalProperties": false
              }
            },
            "pactSlots": {
              "type": "object",
              "properties": { "used": { "type": "integer", "minimum": 0 } },
              "required": ["used"],
              "additionalProperties": false
            },
            "concentration": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "freeKnownSlots": {
              "description": "Vagas de magia conhecida liberadas por ajuste retroativo (site/js legado: campo `_slots_magia_livre`) — quantas magias o jogador ainda pode escolher para preencher o limite da classe.",
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["known", "prepared", "spellbook", "slots", "pactSlots", "concentration", "freeKnownSlots"],
          "additionalProperties": false
        },
        "inventory": { "type": "array", "items": { "$ref": "#/$defs/inventoryEntry" } },
        "wallet": {
          "type": "object",
          "properties": {
            "pc": { "type": "number", "minimum": 0 },
            "pp": { "type": "number", "minimum": 0 },
            "pe": { "type": "number", "minimum": 0 },
            "po": { "type": "number", "minimum": 0 },
            "pl": { "type": "number", "minimum": 0 }
          },
          "required": ["pc", "pp", "pe", "po", "pl"],
          "additionalProperties": false
        },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "activeEffects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instanceId": { "$ref": "#/$defs/instanceId" },
              "sourceInstanceId": { "type": ["string", "null"] },
              "data": {}
            },
            "required": ["instanceId"],
            "additionalProperties": false
          }
        },
        "usageFlags": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "additionalProperties": true
        }
      },
      "required": [
        "level",
        "xp",
        "abilities",
        "hitPoints",
        "hitDice",
        "deathSaves",
        "exhaustion",
        "heroicInspiration",
        "resources",
        "spells",
        "inventory",
        "wallet",
        "conditions",
        "activeEffects",
        "usageFlags"
      ],
      "additionalProperties": false
    },

    "overrideEntry": {
      "type": "object",
      "properties": {
        "value": { "type": ["number", "string", "boolean", "null"] },
        "original": { "type": ["number", "string", "boolean", "null"] },
        "editedAt": { "$ref": "common.schema.json#/$defs/isoDateTime" },
        "source": { "enum": ["manual", "repair"] },
        "warning": { "type": "string" }
      },
      "required": ["value", "original", "editedAt", "source"],
      "additionalProperties": false
    },
    "overrides": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "additionalProperties": { "$ref": "#/$defs/overrideEntry" }
    },

    "extensions": {
      "type": "object",
      "properties": {
        "legacyPassthrough": { "type": "object" }
      },
      "required": ["legacyPassthrough"],
      "additionalProperties": false
    },

    "metadata": {
      "type": "object",
      "properties": {
        "createdAt": { "$ref": "common.schema.json#/$defs/isoDateTime" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/isoDateTime" },
        "creationConfig": { "type": "object" }
      },
      "required": ["createdAt", "updatedAt", "creationConfig"],
      "additionalProperties": false
    }
  }
}
