{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fichas-de-nimb.dev/v1/migration-map.schema.json",
  "title": "Migration map entity (v1)",
  "description": "Mapa de migração de ids legados do monólito (formato livre, pré-refatoração) para ContentIds v1 qualificados.",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "migration-map" },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "from": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "to": { "$ref": "common.schema.json#/$defs/contentId" }
            },
            "required": ["from", "to"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "mappings"]
    }
  ],
  "unevaluatedProperties": false
}
